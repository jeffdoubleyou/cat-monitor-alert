# ONVIF camera
CAMERA_HOST=192.168.1.50
CAMERA_ONVIF_PORT=80
CAMERA_USER=admin
CAMERA_PASSWORD=changeme
CAMERA_ONVIF_HTTPS=false
CAMERA_ONVIF_TIMEOUT=10
# Optional: skip ONVIF stream discovery and use this RTSP URL directly
# CAMERA_RTSP_URL=rtsp://admin:changeme@192.168.1.50:554/Streaming/Channels/101
CAMERA_PROFILE_INDEX=0

# Frame grab
SNAPSHOT_INTERVAL_SECONDS=5
RTSP_TRANSPORT=tcp
CAPTURE_TIMEOUT_SECONDS=15

# Detection (COCO class names, comma-separated)
YOLO_MODEL=yolo11n.pt
DETECT_CLASSES=cat
DETECT_CONFIDENCE=0.45
INFERENCE_DEVICE=cpu

# Alerts
ALERT_COOLDOWN_SECONDS=60
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=your-unguessable-topic
# NTFY_TOKEN=
NTFY_PRIORITY=high
NTFY_TITLE=Cat detected

# Tapo C100 / similar: ONVIF camera accounts cannot drive the speaker.
# Use the Tapo *app* password (cloud password), not CAMERA_PASSWORD.
# Also enable Tapo app: Me > Tapo Lab > Third-Party Compatibility.
# TAPO_USERNAME=admin
# TAPO_CLOUD_PASSWORD=
# TAPO_ALARM_SECONDS=3
# Built-in C100 sounds: siren, emergency, red_alert (or 0/1/2)
# TAPO_ALARM_SOUND=siren

# ONVIF speaker. Leave the clip token empty to play the first clip the camera reports.
# ONVIF_AUDIO_CLIP_TOKEN=
ONVIF_AUDIO_REPEAT_CYCLES=1
# Amcrest/Dahua cameras without ONVIF clips use CGI talk-back automatically.
# Optional RTSP talk-back URL if CGI is also unavailable:
# AUDIO_BACKCHANNEL_URL=rtsp://admin:changeme@192.168.1.50:554/Streaming/Channels/101?backchannel=1

# Optional JPEG dump directory for debugging (use /app/snapshots in Docker)
# SNAPSHOT_DIR=./snapshots

LOG_LEVEL=INFO
DRY_RUN=false
